[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "tokenslim"
version = "0.5.1"
description = "结构化日志与命令输出压缩库"
requires-python = ">=3.9"
license = { text = "MIT" }
authors = [{ name = "TokenSlim Team" }]
dependencies = [
    "click>=8.0",
    "rich>=12.0",
    "platformdirs>=2.5",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.0",
    "mypy>=1.0",
    "ruff>=0.3",
]

[tool.hatch.build.targets.wheel]
packages = ["src/tokenslim"]

[tool.pytest.ini_options]
addopts = "-ra -q"
testpaths = ["tests"]
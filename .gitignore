# ==========================================
# TokenSlim Project .gitignore
# ==========================================

# ------------------------------------------
# 1. 临时文件与本地测试输出
# ------------------------------------------
tmp/
scratch/
tests/output/
test_temp*.txt
check_output.txt
head_gcc.txt

# 本地 AI 对话记录 (可根据需要保留或删除)
对话.md
日志.txt
.waylog/
.kiro/
.opencode/
.sisyphus/

# 同步脚本生成的本地备忘 (sync-to-publish2.ps1 写)
.sync-*

# ------------------------------------------
# 2. IDE 与编辑器缓存
# ------------------------------------------
.vs/
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# ------------------------------------------
# 3. Rust (Core & Plugins)
# ------------------------------------------
target/
**/*.rs.bk

# ------------------------------------------
# 4. Python (Scripts & Tests)
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.env
.env/

# ------------------------------------------
# 4.1 审计中间快照
# ------------------------------------------
docs/audit/**/*.2026*.json
docs/audit/**/*.2026*.csv
docs/audit/**/*.2026*.diff.md
docs/audit/**/*.all_*.json
docs/audit/**/*.all_*.csv
docs/audit/**/*.all_*.diff.md
# drift_audit preflight 临时报告（时间戳文件名，"漂移"是审计时的瞬时快照，存仓无价值）
docs/audit/**/drift_audit_2*.json
docs/audit/**/sample_quality/
# 审计脚本每次运行时重新生成的中间产物，存仓无价值：
#   compact_resolved.txt —— 各 cases 下的压缩中间残留
#   *.v<数字>* —— 带版本/时间戳标签的瞬时快照（如 *.v2026*、*.v1712171123*）
docs/audit/**/compact_resolved.txt
docs/audit/**/*.v[0-9]*

# ------------------------------------------
# 5. Node.js & Web 拓展 (VSCode / Chrome)
# ------------------------------------------
node_modules/
vscode-extension/out/
chrome-extension/dist/
*.tsbuildinfo

# ------------------------------------------
# 6. Java & Gradle (JetBrains Plugin)
# ------------------------------------------
.gradle/
jetbrains-plugin/build/
jetbrains-plugin/.gradle/


# Generated by Cargo
/target/
**/*.rs.bk
Cargo.lock
.gradle/
jetbrains-plugin/.gradle
.agent/
.codex/
.gemini/
.kiro/
.opencode/
.trae/
.vscode/
other/
openspec/
vcs_compact_showcase_report_20260412_15.txt

# Local AI assistant state
.qoder/
# Personal notes
计划.md
plan-en.md
plan-zh-cn.md
讨论.md

# TokenSlim redact blacklist (本地黑名单, 不入仓库, 见 .tokenslim-redact.toml.example)
.tokenslim-redact.toml

# Code graph database (代码知识图谱数据库，含版本历史，不入仓库)
.code_graph.db
# Local TokenSlim audit data (never commit)
.tokenslim/

# ==========================================
# 8. Agent 本地状态与一次性工作产物
# ==========================================

# Agent 审查备份（本地审查脚本/压力日志/票证副本，不入仓库）
.agent_backups/

# AI 助手本地状态
.workbuddy/

# code_graph 本地忽略配置（本地私有，code_graph 子项目 .gitignore 亦排除）
.codegraphignore

# ------------------------------------------
# 9. npm 二进制包构建产物
# ------------------------------------------
# 由 scripts/build-npm-binary-package.mjs 从根 config/ 拷贝，源为已跟踪 config/
packages/cli-binary-windows-x64/config/

# ------------------------------------------
# 10. 审计瞬时快照（v20 日期标签 lossless 检查，与 2026 规则同类）
# ------------------------------------------
docs/audit/**/*.v20*_lossless_check.csv
docs/audit/**/*.v20*_lossless_check.diff.md
docs/audit/**/*.v20*_lossless_check.json
docs/audit/backfill/
docs/audit/vcs_git/
docs/audit/semantic_preservation_audit.pre_ledger_fix_20260818_1003.md
docs/audit/semantic_preservation_audit.pre_merge_20260818_001.md
docs/audit/**/ledger_svn_segment_check.txt
docs/audit/分片审计者操作指南.md

# ------------------------------------------
# 11. Call Warden 审查覆盖率工具产物（可再生/运行时临时，不入仓库）
#     —— 人工资产（.callwardenignore、scripts/review_coverage_ledger.py）须入库
# ------------------------------------------
# 代码索引探测运行目录
.cw_probe/
# 巨型调用图分析产物（每次 scan 全量再生成）
docs/reports/review_callgraph.json
# 复审覆盖账本（脚本生成状态，随复审持续变动，不入库）
docs/reports/review_coverage_ledger.json

